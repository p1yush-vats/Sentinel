# SENTINEL Backend Configuration Template

# Application Setup
APP_NAME="SENTINEL Work Integrity System"
APP_VERSION="1.0.0"
DEBUG=False

# API Prefix
API_V1_PREFIX="/api/v1"

# Database Configuration
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:YOUR_PORT/YOUR_DB"

# Security (Change these in production!)
# Generate a secret key using: openssl rand -hex 32
SECRET_KEY="change-me-to-a-secure-random-hex-string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Origins (Comma-separated list of allowed frontend URLs)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://sentinel-self.vercel.app"]

# Redis Configuration (Optional, for Celery/Caching)
REDIS_URL="redis://localhost:6379/0"

# Email / SMTP Configuration (For alerts and reports)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
SMTP_FROM_EMAIL="noreply@sentinel.com"

# Organizational Work Rules
DEFAULT_WORK_MINUTES_PER_HOUR=50
DEFAULT_BREAK_MINUTES_PER_HOUR=10
DEFAULT_LUNCH_DURATION_MINUTES=30
DEFAULT_DAILY_WORK_TARGET=400

# AI/Detection Sensitivity
ABNORMALITY_CONFIDENCE_THRESHOLD=0.7
HIGH_RISK_SCORE_THRESHOLD=70.0

# Storage
REPORTS_DIR="./reports"
MAX_UPLOAD_SIZE=10485760
