# Application
APP_NAME="SENTINEL Work Integrity System"
APP_VERSION="1.0.0"
DEBUG=False

# API
API_V1_PREFIX="/api/v1"

# Database - CORRECTED: Added +asyncpg and fixed username
DATABASE_URL="postgresql+asyncpg://postgres.jjobzfiwznmascgzvazn:IrgMUYbjfIXxvy7D@aws-1-ap-south-1.pooler.supabase.com:6543/postgres"

# Security
SECRET_KEY="your-super-secret-key-change-this-in-production-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# Redis
REDIS_URL="redis://localhost:6379/0"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM_EMAIL="noreply@sentinel.com"

# Work Rules
DEFAULT_WORK_MINUTES_PER_HOUR=50
DEFAULT_BREAK_MINUTES_PER_HOUR=10
DEFAULT_LUNCH_DURATION_MINUTES=30
DEFAULT_DAILY_WORK_TARGET=400

# Detection
ABNORMALITY_CONFIDENCE_THRESHOLD=0.7
HIGH_RISK_SCORE_THRESHOLD=70.0

# Storage
REPORTS_DIR="./reports"
MAX_UPLOAD_SIZE=10485760