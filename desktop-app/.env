# SENTINEL Desktop App Configuration

# ============================================
# BACKEND API
# ============================================
# Backend API URL (required)
API_BASE_URL=https://sentinel-ofye.onrender.com

# ============================================
# SECURITY
# ============================================
# Database Encryption Key (generate a secure random key in production)
# Used for encrypting JWT tokens and sensitive data
DB_ENCRYPTION_KEY=your-encryption-key-here

# ============================================
# WORK RULES (Optional - defaults shown)
# ============================================
# Minutes of work required per hour (default: 50)
WORK_MINUTES_PER_HOUR=50

# Minutes of break earned per hour (default: 10)
BREAK_MINUTES_PER_HOUR=10

# Lunch break duration in minutes (default: 30)
LUNCH_DURATION_MINUTES=30

# Daily work target in minutes (default: 400 = 8 hours)
DAILY_WORK_TARGET_MINUTES=400

# ============================================
# DETECTION SETTINGS (New!)
# ============================================
# Minimum confidence score to report abnormality (0.0 - 1.0)
# Lower = more sensitive, more false positives
# Higher = less sensitive, fewer detections
# Default: 0.7 (70% confidence required)
ABNORMALITY_CONFIDENCE_THRESHOLD=0.7

# ============================================
# SYNC SETTINGS (New!)
# ============================================
# How often to sync with backend (in seconds)
# Default: 60 (sync every minute)
SYNC_INTERVAL_SECONDS=60

# Maximum number of items to keep in offline queue
# Default: 1000
OFFLINE_QUEUE_MAX_SIZE=1000

# ============================================
# STORAGE (New!)
# ============================================
# Directory for local database and logs
# Default: ~/.sentinel (leave commented to use default)
# DB_DIR=/custom/path/.sentinel

# ============================================
# UI SETTINGS (New!)
# ============================================
# Theme: dark or light
# Default: dark
THEME=dark

# ============================================
# LOGGING (New!)
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR
# Default: INFO
LOG_LEVEL=INFO