# SENTINEL Desktop App Configuration Template

# ============================================
# BACKEND API
# ============================================
# The public URL of your deployed Backend API
API_BASE_URL=http://localhost:8000

# ============================================
# EMPLOYEE PORTAL
# ============================================
# The public URL of your deployed Admin/Employee Dashboard
PORTAL_URL=http://localhost:3000

# ============================================
# SECURITY
# ============================================
# A secret key used to encrypt the local SQLite cache
DB_ENCRYPTION_KEY=your-local-encryption-key-random-string

# ============================================
# WORK RULES
# ============================================
WORK_MINUTES_PER_HOUR=50
BREAK_MINUTES_PER_HOUR=10
LUNCH_DURATION_MINUTES=30
DAILY_WORK_TARGET_MINUTES=400

# ============================================
# DETECTION SETTINGS
# ============================================
# Confidence threshold for flagging abnormalities (0.0 - 1.0)
ABNORMALITY_CONFIDENCE_THRESHOLD=0.7

# ============================================
# SYNC SETTINGS
# ============================================
# How often to push local detections to the cloud (seconds)
SYNC_INTERVAL_SECONDS=60
OFFLINE_QUEUE_MAX_SIZE=1000

# ============================================
# UI SETTINGS
# ============================================
THEME=dark

# ============================================
# LOGGING
# ============================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
